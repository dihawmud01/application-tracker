generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProficiencyLevel { BEGINNER BASIC INTERMEDIATE ADVANCED EXPERT }
enum EmploymentType { FULL_TIME PART_TIME CONTRACT TEMPORARY INTERNSHIP FREELANCE OTHER }
enum RequirementType { SKILL EXPERIENCE EDUCATION CERTIFICATION LANGUAGE LOCATION OTHER }
enum RequirementImportance { LOW MEDIUM HIGH CRITICAL }
enum ImportMethod { URL PASTED_TEXT MANUAL }
enum ImportStatus { PENDING FETCHING EXTRACTING DRAFT_READY CONFIRMED FAILED }
enum ApplicationStatus { WISHLIST APPLIED SCREENING ASSESSMENT INTERVIEW OFFERING ACCEPTED REJECTED WITHDRAWN }
enum RecruitmentEventType { STATUS_CHANGED NOTE CONTACT ASSESSMENT_SCHEDULED INTERVIEW_SCHEDULED OFFER_RECEIVED OTHER }
enum TaskType { FOLLOW_UP ASSESSMENT INTERVIEW_PREPARATION DOCUMENT RESEARCH OTHER }
enum TaskStatus { TODO IN_PROGRESS DONE CANCELLED }
enum DocumentType { CV COVER_LETTER PORTFOLIO CERTIFICATE TRANSCRIPT OTHER }
enum AnalysisType { JOB_FIT SKILL_GAP PROFILE_SKILL_EXTRACTION JOB_EXTRACTION }
enum AnalysisStatus { PENDING RUNNING SUCCEEDED FAILED NEEDS_REVIEW }
enum MatchStatus { MATCH PARTIAL_MATCH GAP UNKNOWN }

model UserAccount {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
}

model AuthSession {
  id         String      @id @default(cuid())
  userId     String
  tokenHash  String      @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model CareerProfile {
  id             String          @id @default(cuid())
  fullName       String
  headline       String?
  summary        String?
  email          String?
  phone          String?
  location       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  education      Education[]
  experiences    Experience[]
  certifications Certification[]
  profileSkills  ProfileSkill[]
  projects       Project[]
  documents      Document[]
  analyses       AIAnalysis[]
}

model Education {
  id           String        @id @default(cuid())
  profileId    String
  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model Experience {
  id             String          @id @default(cuid())
  profileId      String
  company        String
  jobTitle       String
  employmentType EmploymentType?
  location       String?
  startDate      DateTime?
  endDate        DateTime?
  description    String
  createdAt      DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  profile        CareerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model Certification {
  id            String        @id @default(cuid())
  profileId     String
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profile       CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model Skill {
  id            String          @id @default(cuid())
  name          String          @unique
  category      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  profileSkills ProfileSkill[]
  projectSkills ProjectSkill[]
  requirements  JobRequirement[]
}

model ProfileSkill {
  id               String           @id @default(cuid())
  profileId        String
  skillId          String
  proficiencyLevel ProficiencyLevel
  evidenceNotes    String?
  lastAssessedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          CareerProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@unique([profileId, skillId])
  @@index([skillId])
}

model Project {
  id            String        @id @default(cuid())
  profileId     String
  name          String
  description   String
  repositoryUrl String?
  demoUrl       String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profile       CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectSkills ProjectSkill[]
  @@index([profileId])
}

model ProjectSkill {
  projectId     String
  skillId       String
  evidenceNotes String?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@id([projectId, skillId])
  @@index([skillId])
}

model Document {
  id             String                @id @default(cuid())
  profileId      String
  fileName       String
  storageKey     String                @unique
  mimeType       String
  fileSize       BigInt
  documentType   DocumentType          @default(OTHER)
  checksumSha256 String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  profile        CareerProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  applications   ApplicationDocument[]
  @@index([profileId, createdAt])
}

model JobPosting {
  id              String           @id @default(cuid())
  companyName     String
  jobTitle        String
  sourceUrl       String?
  location        String?
  employmentType  EmploymentType?
  salaryMin       Decimal?         @db.Decimal(14, 2)
  salaryMax       Decimal?         @db.Decimal(14, 2)
  salaryCurrency  String?          @db.VarChar(3)
  salaryPeriod    String?
  description     String
  postedAt        DateTime?
  deadline        DateTime?
  sourceSnapshot  String?
  sourceFetchedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  requirements    JobRequirement[]
  importAttempts  ImportAttempt[]
  application     Application?
  analyses        AIAnalysis[]
  @@index([companyName, jobTitle])
  @@index([deadline])
  @@index([createdAt])
}

model JobRequirement {
  id              String                @id @default(cuid())
  jobPostingId    String
  skillId         String?
  requirementType RequirementType
  description     String
  importance      RequirementImportance @default(MEDIUM)
  isMandatory     Boolean               @default(false)
  weight          Float                 @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  jobPosting      JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill           Skill?                @relation(fields: [skillId], references: [id], onDelete: SetNull)
  @@index([jobPostingId])
  @@index([skillId])
}

model ImportAttempt {
  id           String       @id @default(cuid())
  jobPostingId String?
  sourceUrl    String?
  method       ImportMethod
  status       ImportStatus @default(PENDING)
  errorCode    String?
  errorMessage String?
  draftData    Json?
  attemptedAt  DateTime     @default(now())
  completedAt  DateTime?
  jobPosting   JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  @@index([status, attemptedAt])
  @@index([jobPostingId])
}

model Application {
  id                String              @id @default(cuid())
  jobPostingId      String              @unique
  appliedAt         DateTime?
  currentStatus     ApplicationStatus   @default(APPLIED)
  salaryExpectation Decimal?            @db.Decimal(14, 2)
  salaryCurrency    String?             @db.VarChar(3)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  jobPosting        JobPosting           @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  events            RecruitmentEvent[]
  tasks             Task[]
  documents         ApplicationDocument[]
  @@index([currentStatus, updatedAt])
  @@index([appliedAt])
}

model RecruitmentEvent {
  id             String               @id @default(cuid())
  applicationId  String
  eventType      RecruitmentEventType
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus?
  occurredAt     DateTime             @default(now())
  notes          String?
  createdAt      DateTime             @default(now())
  application    Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, occurredAt])
}

model Task {
  id            String      @id @default(cuid())
  applicationId String
  title         String
  description   String?
  taskType      TaskType    @default(OTHER)
  status        TaskStatus  @default(TODO)
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([status, dueAt])
  @@index([applicationId])
}

model ApplicationDocument {
  applicationId String
  documentId    String
  documentType  DocumentType @default(OTHER)
  attachedAt    DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document      Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@id([applicationId, documentId])
  @@index([documentId])
}

model AIAnalysis {
  id            String         @id @default(cuid())
  profileId     String
  jobPostingId  String?
  analysisType  AnalysisType
  status        AnalysisStatus @default(PENDING)
  provider      String?
  modelName     String?
  promptVersion String?
  scoringVersion String?
  inputSnapshot Json
  resultJson    Json?
  fitScore      Float?
  coverage      Float?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  confirmedAt   DateTime?
  profile       CareerProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  jobPosting    JobPosting?    @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  items         AIAnalysisItem[]
  @@index([profileId, createdAt])
  @@index([jobPostingId, createdAt])
  @@index([status, createdAt])
}

model AIAnalysisItem {
  id             String       @id @default(cuid())
  analysisId     String
  criterionKey   String
  criterionName  String
  weight         Float
  score          Float?
  matchStatus    MatchStatus
  evidence       Json
  gapDescription String?
  isMandatory    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  analysis       AIAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@unique([analysisId, criterionKey])
  @@index([analysisId])
}
